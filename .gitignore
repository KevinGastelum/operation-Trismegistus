
# >>> os-warren >>>
# Secrets — never commit.
.env
.env.*
!.env.example
*.pem
*.key

# Warren — local runtime artifacts (keep .warren/*.yaml + pr-template.md tracked).
.warren/tmp/
.warren/*.log

# Claude Code — local session settings & custom skills.
!.claude/settings.local.json
!.claude/skills/
!.claude/hooks/suggest-handoff.js
.claude/.credentials.json
.claude/.last-cleanup
.claude/backups/
.claude/projects/
.claude/sessions/
.claude/shell-snapshots/
.claude.json

# Bun runtime cache.
.bun/

# Warren burrow runtime artifact (rendered per-run; not project state).
.canopy/agent.json

# Burrow git identity overlay.
.gitconfig.burrow

# MSYS2 / Git Bash crash dumps.
*.stackdump
# <<< os-warren <<<

# Scratch briefs / temporary agent artifacts.
.tmp/
